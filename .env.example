# ==========================================
# CAMPAIGN BLAST PLATFORM - ENVIRONMENT EXAMPLE
# Salin file ini menjadi .env dan sesuaikan nilainya
# ==========================================

# 1. Database Configuration (MariaDB / MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/campaign_blast"
#DB_HOST="localhost"
#DB_PORT=3306
#DB_USER="root"
#DB_PASSWORD=""
#DB_NAME="campaign_blast"

# 2. JWT & Security Secrets
JWT_SECRET="ganti_dengan_jwt_secret_acak_minimal_32_karakter"
JWT_REFRESH_SECRET="ganti_dengan_refresh_secret_acak_minimal_32_karakter"

# 3. Server & Client URL
PORT=3000
FRONTEND_URL="http://localhost:5173"

# 4. Platform System SMTP Configuration
# Digunakan untuk email transaksional sistem (OTP Register, Reset Password, Undangan Tim).
# Biarkan kosong jika ingin menggunakan console dev-mode (log OTP di terminal).
SYSTEM_SMTP_HOST="smtp.example.com"
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURE=false
SYSTEM_SMTP_USER="noreply@domainanda.com"
SYSTEM_SMTP_PASS="password_atau_app_password_smtp"
SYSTEM_SMTP_FROM="Campaign Blast <noreply@domainanda.com>"
