// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  contacts               Contact[]
  lists                  List[]
  tags                   Tag[]
  smtpConfig             smtpConfig?
  telegramBot            TelegramBot?
  templates              Template[]
  telegramBotId          Int?
  whatsappQrSession      WhatsappQrSession?
  whatsappBusinessConfig WhatsappBusinessConfig?
  campaigns              Campaign[]

  @@map("tenants")
}

model User {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  name             String    @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  status           String    @db.VarChar(50)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  refreshTokens      RefreshToken[]
  templateVersions   TemplateVersion[]
  campaigns          Campaign[]          @relation("CampaignOwner")
  approvedCampaigns  Campaign[]          @relation("CampaignApprover")

  @@map("users")
}

model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int?     @map("tenant_id")
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("audit_logs")
}

model Role {
  id       Int     @id @default(autoincrement())
  tenantId Int?    @map("tenant_id")
  name     String  @db.VarChar(255)
  isCustom Boolean @default(false) @map("is_custom")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Contact {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  name           String    @db.VarChar(255)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(255)
  whatsappNumber String?   @map("whatsapp_number") @db.VarChar(255)
  teleChatId     String?   @map("tele_chat_id") @db.VarChar(255)
  status         String    @default("active") @db.VarChar(50)
  customFields   Json?     @map("custom_fields_json")
  lastInboundAt  DateTime? @map("last_inbound_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listContacts ListContact[]
  contactTags  ContactTag[]
  consents           Consent[]
  campaignRecipients CampaignRecipient[]

  @@index([tenantId], map: "idx_contacts_tenant")
  @@index([tenantId, whatsappNumber], map: "idx_contacts_tenant_wa")
  @@index([tenantId, email], map: "idx_contacts_tenant_email")
  @@map("contacts")
}

model List {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listContacts ListContact[]

  @@unique([tenantId, name], map: "uq_list_tenant_name")
  @@map("lists")
}

model ListContact {
  listId    Int      @map("list_id")
  contactId Int      @map("contact_id")
  addedAt   DateTime @default(now()) @map("added_at")

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId], map: "idx_list_contacts_contact")
  @@map("list_contacts")
}

model Tag {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([tenantId, name], map: "uq_tag_tenant_name")
  @@map("tags")
}

model ContactTag {
  contactId Int @map("contact_id")
  tagId     Int @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Consent {
  id        Int      @id @default(autoincrement())
  contactId Int      @map("contact_id")
  status    String   @default("opted_in") @db.VarChar(50)
  channel   String   @db.VarChar(50)
  updatedAt DateTime @default(now()) @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel], map: "uq_consent_contact_channel")
  @@map("consents")
}

model smtpConfig {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @unique @map("tenant_id")
  host              String    @db.VarChar(255)
  port              Int       @default(587)
  username          String    @db.VarChar(255)
  passwordEncrypted String    @map("password_encrypted") @db.VarChar(255)
  fromName          String?   @map("from_name") @db.VarChar(255)
  fromEmail         String?   @map("from_email") @db.VarChar(255)
  encryption        String    @default("TLS") @db.VarChar(50) // "SSL", "TLS", "none"
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

model Template {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  name        String    @db.VarChar(255)
  channelMode String    @default("email") @map("channel_mode") @db.VarChar(50) // email, whatsapp, telegram, multiple
  category    String?   @db.VarChar(100) // promotion, newsletter, transactional, announcement
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions  TemplateVersion[]
  campaigns Campaign[]

  @@index([tenantId], map: "idx_templates_tenant")
  @@map("templates")
}

model TemplateVersion {
  id         Int @id @default(autoincrement())
  templateId Int @map("template_id")
  versionNo  Int @default(1) @map("version_no")

  // konten multi saluran
  subject         String? @db.VarChar(255) // subjek email
  preheader       String? @db.VarChar(255) // preheader email
  contentJson     Json?   @map("content_json") // menyimpan warna, logo dll
  contentHtml     String? @map("content_html") @db.Text // hasil compile HTML / Raw HTML
  contentWhatsapp String? @map("content_whatsapp") @db.Text // pesan teks WhatsApp
  contentTelegram String? @map("content_telegram") @db.Text // pesan teks Telegram

  // waba
  language               String?   @default("id") @db.VarChar(20) // misal: id / en_US
  metaTemplateId         String?   @map("meta_template_id") @db.VarChar(255) // ID template dari Meta
  whatsappCategory       String?   @map("whatsapp_category") @db.VarChar(50) // Marketing / Utility / Authentication
  whatsappApprovalStatus String?   @default("draft") @map("whatsapp_approval_status") @db.VarChar(50) // draft / approved / rejected
  rejectedReason         String?   @map("rejected_reason") @db.Text // Alasan ditolak Meta
  lastSyncAt             DateTime? @map("last_sync_at") // Waktu sinkronisasi status terakhir

  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator     User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  campaigns   Campaign[]

  @@unique([templateId, versionNo], map: "uq_template_version")
  @@index([metaTemplateId], map: "idx_template_meta_id")
  @@map("template_versions")
}

model TelegramBot {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @unique @map("tenant_id")
  botToken     String    @map("bot_token") @db.VarChar(255)
  botUsername  String?   @map("bot_username") @db.VarChar(100)
  botName      String?   @map("bot_name") @db.VarChar(100)
  targetChatId String?   @map("target_chat_id") @db.VarChar(100)
  status       String    @default("disconnected") @db.VarChar(50) // connected / disconnected
  connectedAt  DateTime? @map("connected_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("telegram_bots")
}

// Jalur Unofficial WhatsApp Web QR
model WhatsappQrSession {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @unique @map("tenant_id")
  status            String    @default("disconnected") @db.VarChar(50) // connected, disconnected qr_ready, scanning
  phoneNumber       String?   @map("phone_number") @db.VarChar(50)
  pushName          String?   @map("push_name") @db.VarChar(100)
  qrRaw             String?   @map("qr_raw") @db.Text // base64 QR code
  connectedAt       DateTime? @map("connected_at")
  lastActiveAt      DateTime? @map("last_active_at")
  dailyCount        Int       @default(0) @map("daily_count") // berapa pesan yang sudah terkirim hari ini
  dailyQuota        Int       @default(300) @map("daily_quota") // batas aman
  lastMessageSentAt DateTime? @map("last_message_sent_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_qr_sessions")
}

// WhatsApp Business API 
model WhatsappBusinessConfig {
  id                 Int       @id @default(autoincrement())
  tenantId           Int       @unique @map("tenant_id")
  phoneNumberId      String    @map("phone_number_id") @db.VarChar(100)
  wabaId             String    @map("waba_id") @db.VarChar(100)
  accessToken        String    @map("access_token") @db.VarChar(500)
  displayPhoneNumber String?   @map("display_phone_number") @db.VarChar(50)
  messagingTier      String    @default("TIER_1K") @map("messaging_tier") @db.VarChar(50)
  qualityRating      String    @default("GREEN") @map("quality_rating") @db.VarChar(50)
  status             String    @default("connected") @db.VarChar(50) // connected, disconnected
  verifiedAt         DateTime? @map("verified_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("whatsapp_business_configs")
}

model Campaign {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @map("tenant_id")
  ownerUserId       Int       @map("owner_user_id")
  name              String    @db.VarChar(255)
  templateId        Int?      @map("template_id")
  templateVersionId Int?      @map("template_version_id")
  status            String    @default("draft") @db.VarChar(50) // draft, scheduled, sending, sent, failed, paused, cancelled
  channel           String    @db.VarChar(50) // email, telegram, whatsapp_qr, whatsapp_business
  audienceType      String?   @default("all") @map("audience_type") @db.VarChar(50) // list, tag, all
  audienceRef       String?   @map("audience_ref") @db.VarChar(100) // list:1, tag:2, all
  scheduledAt       DateTime? @map("scheduled_at")
  sentAt            DateTime? @map("sent_at")
  completedAt       DateTime? @map("completed_at")
  recurrenceRule    String?   @map("recurrence_rule") @db.VarChar(100)
  approvedById      Int?      @map("approved_by")

  // Real-time counter metrics (updated by worker during execution)
  totalRecipients   Int       @default(0) @map("total_recipients")
  sentCount         Int       @default(0) @map("sent_count")
  deliveredCount    Int       @default(0) @map("delivered_count")
  readCount         Int       @default(0) @map("read_count")
  failedCount       Int       @default(0) @map("failed_count")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner           User              @relation("CampaignOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  approver        User?             @relation("CampaignApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  template        Template?         @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion TemplateVersion?  @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  recipients      CampaignRecipient[]

  @@index([tenantId, status], map: "idx_campaigns_tenant_status")
  @@index([scheduledAt], map: "idx_campaigns_scheduled")
  @@map("campaigns")
}

model CampaignRecipient {
  id                Int       @id @default(autoincrement())
  campaignId        Int       @map("campaign_id")
  contactId         Int       @map("contact_id")
  channel           String    @db.VarChar(50) // email, telegram, whatsapp_qr, whatsapp_business
  status            String    @default("queued") @db.VarChar(50) // queued, sending, sent, delivered, read, failed
  providerMessageId String?   @unique(map: "uq_recipient_provider_msg_id") @map("provider_message_id") @db.VarChar(255)
  errorCode         String?   @map("error_code") @db.VarChar(100)
  errorMessage      String?   @map("error_message") @db.Text
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  campaign     Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]

  @@unique([campaignId, contactId, channel], map: "uq_recipients_campaign_contact_channel")
  @@index([campaignId], map: "idx_recipients_campaign")
  @@index([campaignId, status], map: "idx_recipients_campaign_status")
  @@map("campaign_recipients")
}

model DeliveryLog {
  id                  Int      @id @default(autoincrement())
  campaignRecipientId Int      @map("campaign_recipient_id")
  eventType           String   @map("event_type") @db.VarChar(50) // queued, sent, delivered, read, failed
  eventAt             DateTime @default(now()) @map("event_at")
  payloadJson         Json?    @map("raw_payload_json")

  campaignRecipient CampaignRecipient @relation(fields: [campaignRecipientId], references: [id], onDelete: Cascade)

  @@index([campaignRecipientId], map: "idx_logs_recipient")
  @@index([campaignRecipientId, eventType], map: "idx_logs_recipient_event")
  @@map("delivery_logs")
}

