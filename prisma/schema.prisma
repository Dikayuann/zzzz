// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  status    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  contacts      Contact[]
  lists         List[]
  tags          Tag[]
  smtpConfig    smtpConfig?
  telegramBot   TelegramBot?
  templates     Template[]
  telegramBotId Int?

  @@map("tenants")
}

model User {
  id               Int       @id @default(autoincrement())
  tenantId         Int       @map("tenant_id")
  name             String    @db.VarChar(255)
  email            String    @unique @db.VarChar(255)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  status           String    @db.VarChar(50)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  lastLoginAt      DateTime? @map("last_login_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  refreshTokens      RefreshToken[]
  templateVersions   TemplateVersion[]

  @@map("users")
}

model EmailVerification {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_resets")
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  tenantId   Int?     @map("tenant_id")
  actorId    Int?     @map("actor_id")
  action     String   @db.VarChar(255)
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("audit_logs")
}

model Role {
  id       Int     @id @default(autoincrement())
  tenantId Int?    @map("tenant_id")
  name     String  @db.VarChar(255)
  isCustom Boolean @default(false) @map("is_custom")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  module    String   @db.VarChar(50)
  action    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Contact {
  id             Int       @id @default(autoincrement())
  tenantId       Int       @map("tenant_id")
  name           String    @db.VarChar(255)
  email          String?   @db.VarChar(255)
  phone          String?   @db.VarChar(255)
  whatsappNumber String?   @map("whatsapp_number") @db.VarChar(255)
  teleChatId     String?   @map("tele_chat_id") @db.VarChar(255)
  status         String    @default("active") @db.VarChar(50)
  customFields   Json?     @map("custom_fields_json")
  lastInboundAt  DateTime? @map("last_inbound_at")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listContacts ListContact[]
  contactTags  ContactTag[]
  consents     Consent[]

  @@index([tenantId], map: "idx_contacts_tenant")
  @@index([tenantId, whatsappNumber], map: "idx_contacts_tenant_wa")
  @@index([tenantId, email], map: "idx_contacts_tenant_email")
  @@map("contacts")
}

model List {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(255)
  status      String   @default("active") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  listContacts ListContact[]

  @@unique([tenantId, name], map: "uq_list_tenant_name")
  @@map("lists")
}

model ListContact {
  listId    Int      @map("list_id")
  contactId Int      @map("contact_id")
  addedAt   DateTime @default(now()) @map("added_at")

  list    List    @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId], map: "idx_list_contacts_contact")
  @@map("list_contacts")
}

model Tag {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactTags ContactTag[]

  @@unique([tenantId, name], map: "uq_tag_tenant_name")
  @@map("tags")
}

model ContactTag {
  contactId Int @map("contact_id")
  tagId     Int @map("tag_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model Consent {
  id        Int      @id @default(autoincrement())
  contactId Int      @map("contact_id")
  status    String   @default("opted_in") @db.VarChar(50)
  channel   String   @db.VarChar(50)
  updatedAt DateTime @default(now()) @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel], map: "uq_consent_contact_channel")
  @@map("consents")
}

model smtpConfig {
  id                Int       @id @default(autoincrement())
  tenantId          Int       @unique @map("tenant_id")
  host              String    @db.VarChar(255)
  port              Int       @default(587)
  username          String    @db.VarChar(255)
  passwordEncrypted String    @map("password_encrypted") @db.VarChar(255)
  fromName          String?   @map("from_name") @db.VarChar(255)
  fromEmail         String?   @map("from_email") @db.VarChar(255)
  encryption        String    @default("TLS") @db.VarChar(50) // "SSL", "TLS", "none"
  verifiedAt        DateTime? @map("verified_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("smtp_configs")
}

model Template {
  id          Int       @id @default(autoincrement())
  tenantId    Int       @map("tenant_id")
  name        String    @db.VarChar(255)
  channelMode String    @default("email") @map("channel_mode") @db.VarChar(50) // email, whatsapp, telegram, multiple
  category    String?   @db.VarChar(100) // promotion, newsletter, transactional, announcement
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions TemplateVersion[]

  @@index([tenantId], map: "idx_templates_tenant")
  @@map("templates")
}

model TemplateVersion {
  id         Int @id @default(autoincrement())
  templateId Int @map("template_id")
  versionNo  Int @default(1) @map("version_no")

  // konten multi saluran
  subject         String? @db.VarChar(255) // subjek email
  preheader       String? @db.VarChar(255) // preheader email
  contentJson     Json?   @map("content_json") // menyimpan warna, logo dll
  contentHtml     String? @map("content_html") @db.Text // hasil compile HTML / Raw HTML
  contentWhatsapp String? @map("content_whatsapp") @db.Text // pesan teks WhatsApp
  contentTelegram String? @map("content_telegram") @db.Text // pesan teks Telegram

  // waba
  language               String?   @default("id") @db.VarChar(20) // misal: id / en_US
  metaTemplateId         String?   @map("meta_template_id") @db.VarChar(255) // ID template dari Meta
  whatsappCategory       String?   @map("whatsapp_category") @db.VarChar(50) // Marketing / Utility / Authentication
  whatsappApprovalStatus String?   @default("draft") @map("whatsapp_approval_status") @db.VarChar(50) // draft / approved / rejected
  rejectedReason         String?   @map("rejected_reason") @db.Text // Alasan ditolak Meta
  lastSyncAt             DateTime? @map("last_sync_at") // Waktu sinkronisasi status terakhir

  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  template    Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator     User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([templateId, versionNo], map: "uq_template_version")
  @@index([metaTemplateId], map: "idx_template_meta_id")
  @@map("template_versions")
}

model TelegramBot {
  id           Int       @id @default(autoincrement())
  tenantId     Int       @unique @map("tenant_id")
  botToken     String    @map("bot_token") @db.VarChar(255)
  botUsername  String?   @map("bot_username") @db.VarChar(100)
  botName      String?   @map("bot_name") @db.VarChar(100)
  targetChatId String?   @map("target_chat_id") @db.VarChar(100)
  status       String    @default("disconnected") @db.VarChar(50) // connected / disconnected
  connectedAt  DateTime? @map("connected_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("telegram_bots")
}
